{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Routes": [
    {
      "RouteId": "movies",
      "DownstreamPathTemplate": "/api/movies/{everything}",
      "UpstreamPathTemplate": "/api/movies/{everything}",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "monolith",
          "Port": 8080,
          "Weight": 50

        },
        {
          "Host": "movies-service",
          "Port": 8081,
          "Weight": 50
        }
      ]
    },
    {
      "RouteId": "events",
      "DownstreamPathTemplate": "/api/events/{everything}",
      "UpstreamPathTemplate": "/api/events/{everything}",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 8082
        }
      ]
    }
  ],
  "SwaggerEndPoints": [
    {
      "Key": "docs-identity",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Identity API",
          "Version": "v1",
          "Url": "http://identity/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "movies",
      "TransformByOcelotConfig": false,
      "Config": [
        {
          "Name": "Location API",
          "Version": "v1",
          "Url": "http://movies/swagger/v1/swagger.json"
        }
      ]
    }
  ]
}