{
  "Logging": {
    "LogLevel": {
      "Ocelot": "Debug",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GRADUAL_MIGRATION": true,
  "MOVIES_MIGRATION_PERCENT": 97,
  "Routes": [
    {
      "RouteId": "movies",
      "DownstreamPathTemplate": "/api/movies/{everything}",
      "UpstreamPathTemplate": "/api/movies/{everything}",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "monolith",
          "Port": 8080

        },
        {
          "Host": "movies-service",
          "Port": 8081
        }
      ],
      "LoadBalancerOptions": {
        "Type": "WeightedRoundRobinBalancer"
      }
    },
    {
      "RouteId": "events",
      "DownstreamPathTemplate": "/api/events/{everything}",
      "UpstreamPathTemplate": "/api/events/{everything}",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "monolith",
          "Port": 8080
        }
      ]
    },
    {
      "RouteId": "users",
      "DownstreamPathTemplate": "/api/users/{everything}",
      "UpstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamHostAndPorts": [
        {
          "Host": "monolith",
          "Port": 8080
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8000"
  }
}